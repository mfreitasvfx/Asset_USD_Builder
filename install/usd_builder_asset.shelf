<?xml version="1.0" encoding="UTF-8"?>
<!-- Shelf do USD_Builder_Asset.

     Instalar: copie este arquivo (e o usd_builder_asset.svg ao lado) para
         C:/Users/<voce>/Documents/houdini21.0/toolbar/
     Depois, no Houdini: "+" na barra de shelves -> Shelves -> marque
     "USD_Builder". O botao recarrega os modulos a cada clique, entao da'
     para editar no VS Code e clicar de novo, sem reiniciar o Houdini.
-->
<shelfDocument>
  <tool name="usd_builder_asset" label="USD_Builder_Asset"
        icon="C:/dev/USD_Builder_Asset/install/usd_builder_asset.svg">
    <helpText><![CDATA[Abre a janela do USD_Builder_Asset :
1 - SCAN, 2 - BUILD ASSETS, 3 - EXPORT USD's.]]></helpText>
    <script scriptType="python"><![CDATA[exec(open(r"C:\dev\USD_Builder_Asset\install\houdini_reload.py").read())]]></script>
  </tool>

  <tool name="hython_cache" label="Cache_hython" icon="SOP_filecache">
    <helpText><![CDATA[Grava o File Cache / ROP selecionado em hython, fora da GUI.
Salva a cena, abre um console com o hython rodando o cache e,
se voce escolher, fecha este Houdini. Log fica ao lado do .hip.]]></helpText>
    <script scriptType="python"><![CDATA[exec(open(r"C:\dev\hou_batch_cache\shelf_tool.py").read())]]></script>
  </tool>

  <toolshelf name="usd_builder" label="USD_Builder">
    <memberTool name="usd_builder_asset"/>
    <memberTool name="hython_cache"/>
  </toolshelf>
</shelfDocument>
